{
  "name": "aeye",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "node scripts/embed-migrations.ts --check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "HOST=127.0.0.1 PORT=41837 ORIGIN=http://127.0.0.1:41837 node build",
    "prepare": "svelte-kit sync",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.ts",
    "migrations:embed": "node scripts/embed-migrations.ts",
    "fmt": "oxfmt .",
    "ingest": "node scripts/ingest.ts",
    "migrate": "node scripts/migrate.ts",
    "test": "node --test",
    "check": "node scripts/embed-migrations.ts --check && svelte-kit sync && oxfmt --check . && oxlint --type-aware --type-check . && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "fallow": "^3.3.0",
    "fast-check": "^4.9.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
